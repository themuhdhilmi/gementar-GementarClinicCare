# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# PostgreSQL 16 or newer. Percent-encode reserved characters in the password.
DATABASE_URL="postgresql://user:password@host:5432/database"

# 32-byte keys, base64 (openssl rand -base64 32).
# APP_KEK_* encrypts MFA secrets and recovery codes at rest (IAM-R-08); it must
# live outside the database. APP_KEK_ACTIVE names the key new ciphertext uses,
# so a key can be rotated by adding APP_KEK_V2 and flipping this value.
APP_KEK_V1=
APP_KEK_ACTIVE=v1
APP_HASH_PEPPER=

# Row-level security is applied by migrations, so the application account can
# install it itself. `require` refuses to boot unless every tenant-owned table
# has RLS enabled and forced; use it in staging and production.
DB_GUARD_MODE=auto

# Cookies: COOKIE_SECURE must be true anywhere that is not plain-http localhost.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Sized for shared clinic workstations (IAM-Q-02). Raise them if every member
# of staff has their own device.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
REAUTH_MINUTES=5
TRUSTED_DEVICE_DAYS=30

# Argon2id. Tune with `npm run measure:argon2` on the production host (IAM-N-02).
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# Breached-password check. Fails open on timeout (IAM-N-06).
BREACH_CHECK_ENABLED=true
BREACH_CHECK_TIMEOUT_MS=500
BREACH_API_URL=https://api.pwnedpasswords.com/range

# console writes invite and reset links to the log and returns them through the
# API, which is how staff are onboarded before a provider exists. Production
# refuses it. `resend` needs RESEND_API_KEY and a domain with SPF, DKIM and
# DMARC records (IAM-Q-03). `noop` sends nothing, for tests.
MAIL_TRANSPORT=console
MAIL_FROM="ClinicCare <no-reply@example.test>"
RESEND_API_KEY=
APP_BASE_URL=http://localhost:3000
