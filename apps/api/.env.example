# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# MySQL 8. Percent-encode reserved characters in the password.
DATABASE_URL="mysql://user:password@host:3306/database"

# 32-byte keys, base64 (openssl rand -base64 32).
# APP_KEK_* encrypts MFA secrets and recovery codes at rest (IAM-R-08); it must
# live outside the database. APP_KEK_ACTIVE names the key new ciphertext uses,
# so a key can be rotated by adding APP_KEK_V2 and flipping this value.
APP_KEK_V1=
APP_KEK_ACTIVE=v1
APP_HASH_PEPPER=

# Cookies: COOKIE_SECURE must be true anywhere that is not plain-http localhost.
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=168
REAUTH_MINUTES=5
TRUSTED_DEVICE_DAYS=30

# Argon2id. Tune with `npm run measure:argon2` on the production host (IAM-N-02).
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# Breached-password check. Fails open on timeout (IAM-N-06).
BREACH_CHECK_ENABLED=true
BREACH_CHECK_TIMEOUT_MS=500
BREACH_API_URL=https://api.pwnedpasswords.com/range

MAIL_TRANSPORT=console
MAIL_FROM="ClinicCare <no-reply@example.test>"
APP_BASE_URL=http://localhost:3000
