// Gementar ClinicCare — database schema (PostgreSQL 16+).
//
// Conventions (documents/planning/04-data-model.md):
//   * Primary keys        UUID v7, generated in the application, stored as `uuid`
//   * Table / column case snake_case, mapped to camelCase in TypeScript
//   * Timestamps          timestamptz(3), always UTC
//   * Tenancy             tenant_id on every tenant-owned table; composite foreign keys
//                         (id, tenant_id) so a row can never point across tenants
//   * Deletes             no hard deletes on people or records; status columns instead
//
// Row-level security is the second, independent isolation layer and is applied by the
// migration `*_row_level_security`: every tenant-owned table has RLS enabled and FORCED,
// with USING and WITH CHECK policies reading `app.tenant_id` from the transaction.
// See documents/decisions/adr-0002-postgres.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
  LOCKED
}

/// The front desk is three roles, not one (IAM-Q-01). A small clinic gives one
/// person all three and they see what a single front-desk role used to show; a
/// larger one gives each person the part of the counter they actually work.
enum Role {
  ADMIN
  DOCTOR
  NURSE
  RECEPTION
  DISPENSER
  CASHIER
}

enum TokenPurpose {
  RESET
  INVITE
}

enum LoginOutcome {
  SUCCESS
  BAD_CREDENTIALS
  UNKNOWN_EMAIL
  AMBIGUOUS_EMAIL
  NOT_LOGINABLE
  RATE_LIMITED
  MFA_FAILED
}

/// The paying customer: a clinic company. Not itself tenant-scoped — it *is* the tenant.
model Tenant {
  id            String       @id @db.Uuid
  name          String       @db.VarChar(200)
  slug          String       @unique(map: "tenant_slug_key") @db.VarChar(60)
  status        TenantStatus
  plan          String       @default("pilot") @db.VarChar(40)
  timezone      String       @default("Asia/Kuala_Lumpur") @db.VarChar(60)
  currency      String       @default("MYR") @db.Char(3)
  settings      Json         @db.JsonB
  modules       Json         @db.JsonB
  tin           String?      @db.VarChar(40)
  businessRegNo String?      @map("business_reg_no") @db.VarChar(40)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid

  branches            Branch[]
  users               User[]
  patients            Patient[]
  userBranchRoles     UserBranchRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  trustedDevices      TrustedDevice[]
  mfaReplays          MfaReplay[]

  @@index([status], map: "tenant_status_idx")
  @@map("tenant")
}

/// A physical clinic.
model Branch {
  id             String       @id @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  code           String       @db.VarChar(16)
  name           String       @db.VarChar(200)
  addressLine1   String?      @map("address_line1") @db.VarChar(200)
  addressLine2   String?      @map("address_line2") @db.VarChar(200)
  city           String?      @db.VarChar(100)
  state          String?      @db.VarChar(100)
  postcode       String?      @db.VarChar(20)
  phone          String?      @db.VarChar(32)
  email          String?      @db.VarChar(254)
  licenceNo      String?      @map("licence_no") @db.VarChar(60)
  timezone       String?      @db.VarChar(60)
  operatingHours Json         @map("operating_hours") @db.JsonB
  settings       Json         @db.JsonB
  letterhead     Json?        @db.JsonB
  /// TEN-F-10. Its own columns, so a branch read never carries the image.
  letterheadLogo          Bytes?    @map("letterhead_logo")
  letterheadLogoMime      String?   @map("letterhead_logo_mime") @db.VarChar(60)
  letterheadLogoUpdatedAt DateTime? @map("letterhead_logo_updated_at") @db.Timestamptz(3)
  status         BranchStatus
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usersWithDefault User[]           @relation("UserDefaultBranch")
  encounters       Encounter[]
  rooms            BranchRoom[]
  displayTokens    DisplayToken[]
  productSettings  ProductBranchSetting[]
  userBranchRoles  UserBranchRole[]
  sessions         Session[]
  productBatches ProductBatch[]

  @@unique([tenantId, code], map: "branch_tenant_code_key")
  @@unique([id, tenantId], map: "branch_id_tenant_key")
  @@index([tenantId, status], map: "branch_tenant_status_idx")
  @@map("branch")
}

/// A staff login. Owned by IAM; employment lives in HR (V2 `DRM`).
model User {
  id     String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Stored lower-cased and trimmed. A unique index on (tenant_id, lower(email))
  /// in the row-level-security migration makes that a database guarantee too.
  email  String @db.VarChar(254)
  /// Argon2id PHC string. Empty only for INVITED users who have not set one yet.
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  name              String     @db.VarChar(120)
  phone             String?    @db.VarChar(32)
  status            UserStatus
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  failedAttempts    Int        @default(0) @map("failed_attempts")
  /// AES-256-GCM envelope over the TOTP secret. Key lives outside the database.
  mfaSecretEnc      Bytes?     @map("mfa_secret_enc")
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  /// AES-256-GCM envelope over a JSON array of peppered recovery-code hashes.
  mfaRecoveryEnc    Bytes?     @map("mfa_recovery_enc")
  mfaEnrolledAt     DateTime?  @map("mfa_enrolled_at") @db.Timestamptz(3)
  permissionVersion Int        @default(1) @map("permission_version")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  defaultBranchId   String?    @map("default_branch_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy         String?    @map("created_by") @db.Uuid
  updatedBy         String?    @map("updated_by") @db.Uuid

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  defaultBranch       Branch?              @relation("UserDefaultBranch", fields: [defaultBranchId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  branchRoles         UserBranchRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  trustedDevices      TrustedDevice[]
  mfaReplays          MfaReplay[]

  @@unique([tenantId, email], map: "user_tenant_email_key")
  @@unique([id, tenantId], map: "user_id_tenant_key")
  @@index([tenantId, status], map: "user_tenant_status_idx")
  @@index([email], map: "user_email_idx")
  @@index([defaultBranchId, tenantId], map: "user_default_branch_idx")
  @@map("user")
}

/// What a user may do, at which branch. The unit of permission resolution.
model UserBranchRole {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  branch Branch @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([userId, branchId, role], map: "ubr_user_branch_role_key")
  @@index([branchId, role], map: "ubr_branch_role_idx")
  @@index([tenantId, role], map: "ubr_tenant_role_idx")
  @@index([branchId, tenantId], map: "ubr_branch_tenant_idx")
  @@map("user_branch_role")
}

/// Server-side session. The cookie carries an opaque token; only its hash is stored.
model Session {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         Bytes     @map("token_hash")
  activeBranchId    String    @map("active_branch_id") @db.Uuid
  permissionVersion Int       @map("permission_version")
  mfaVerified       Boolean   @default(false) @map("mfa_verified")
  /// Set when the user proved identity again; valid for a few minutes (IAM-F-11).
  reauthAt          DateTime? @map("reauth_at") @db.Timestamptz(3)
  ip                String?   @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(120)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  branch Branch @relation(fields: [activeBranchId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tokenHash], map: "session_token_hash_key")
  @@index([userId, revokedAt], map: "session_user_revoked_idx")
  @@index([expiresAt], map: "session_expires_idx")
  @@index([tenantId, userId], map: "session_tenant_user_idx")
  @@index([activeBranchId, tenantId], map: "session_branch_tenant_idx")
  @@map("session")
}

/// Single-use link for "set your password" (invite) and "reset your password".
model PasswordResetToken {
  id        String       @id @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  tokenHash Bytes        @map("token_hash")
  purpose   TokenPurpose
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?      @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tokenHash], map: "prt_token_hash_key")
  @@index([userId, usedAt], map: "prt_user_used_idx")
  @@index([expiresAt], map: "prt_expires_idx")
  @@map("password_reset_token")
}

/// "Remember this device" for MFA (IAM-F-10).
model TrustedDevice {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  Bytes     @map("token_hash")
  label      String?   @db.VarChar(200)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tokenHash], map: "td_token_hash_key")
  @@index([userId, revokedAt], map: "td_user_revoked_idx")
  @@index([expiresAt], map: "td_expires_idx")
  @@map("trusted_device")
}

/// One row per accepted TOTP step, so a code cannot be replayed inside its window.
model MfaReplay {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  timeStep  BigInt   @map("time_step")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([userId, timeStep], map: "mfa_replay_user_step_key")
  @@index([expiresAt], map: "mfa_replay_expires_idx")
  @@map("mfa_replay")
}

/// Login attempts, for rate limiting and for the failed-login report.
/// Deliberately NOT tenant-scoped: an attempt may not resolve to a tenant at all.
model LoginAttempt {
  id          String       @id @db.Uuid
  emailKey    String       @map("email_key") @db.VarChar(254)
  ip          String?      @db.VarChar(45)
  userAgent   String?      @map("user_agent") @db.VarChar(512)
  outcome     LoginOutcome
  tenantId    String?      @map("tenant_id") @db.Uuid
  userId      String?      @map("user_id") @db.Uuid
  attemptedAt DateTime     @default(now()) @map("attempted_at") @db.Timestamptz(3)

  @@index([emailKey, attemptedAt], map: "login_attempt_email_time_idx")
  @@index([ip, attemptedAt], map: "login_attempt_ip_time_idx")
  @@index([attemptedAt], map: "login_attempt_time_idx")
  @@map("login_attempt")
}

/// Append-only audit trail (module AUD). Updates and deletes are blocked by triggers.
model AuditLog {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  branchId         String?  @map("branch_id") @db.Uuid
  actorId          String?  @map("actor_id") @db.Uuid
  actorName        String   @map("actor_name") @db.VarChar(120)
  actorRole        String?  @map("actor_role") @db.VarChar(40)
  action           String   @db.VarChar(80)
  entityType       String   @map("entity_type") @db.VarChar(60)
  entityId         String?  @map("entity_id") @db.Uuid
  subjectPatientId String?  @map("subject_patient_id") @db.Uuid
  before           Json?    @db.JsonB
  after            Json?    @db.JsonB
  diff             Json?    @db.JsonB
  reason           String?  @db.VarChar(500)
  ip               String?  @db.VarChar(45)
  userAgent        String?  @map("user_agent") @db.VarChar(512)
  requestId        String?  @map("request_id") @db.VarChar(64)
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  // Deliberately no foreign keys. An append-only log of facts must not be able
  // to block work on the rows it describes, and its entries have to outlive
  // them: that is also why actor_name is snapshotted rather than joined.
  // tenant_id is still covered by row-level security.

  @@index([tenantId, occurredAt], map: "audit_tenant_time_idx")
  @@index([tenantId, actorId, occurredAt], map: "audit_tenant_actor_time_idx")
  @@index([tenantId, subjectPatientId, occurredAt], map: "audit_tenant_patient_time_idx")
  @@index([tenantId, entityType, entityId], map: "audit_tenant_entity_idx")
  @@index([tenantId, action, occurredAt], map: "audit_tenant_action_time_idx")
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Patient Registry (PAT, v0-03-patient.md)
//
// The patient is tenant-scoped and carries no branch (PAT-R-08): one patient,
// one record, across every branch of the clinic company. It is the visit that
// happened somewhere, not the person.
// ---------------------------------------------------------------------------

enum IdType {
  MYKAD
  MYKID
  PASSPORT
  ARMY
  POLICE
  OTHER
  NONE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  UNKNOWN
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum PatientStatus {
  ACTIVE
  DECEASED
  MERGED
  DELETED
}

enum AllergyType {
  DRUG
  FOOD
  ENVIRONMENT
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

/// An allergy is never deleted (PAT-R-03). Removal is REFUTED, with a reason.
enum AllergyStatus {
  UNVERIFIED
  VERIFIED
  REFUTED
}

enum ConditionStatus {
  ACTIVE
  RESOLVED
}

enum ConsentChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum ConsentPurpose {
  REMINDERS
  MARKETING
}

enum PatientDocumentType {
  ID_COPY
  REFERRAL_IN
  LAB_RESULT
  CONSENT
  PHOTO
  OTHER
}

model Patient {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Human-readable and immutable, never reused (PAT-R-02).
  mrn  String @db.VarChar(40)
  name String @db.VarChar(150)

  /// Maintained by a database trigger, never by the application (PAT-R-09).
  /// Lower case, diacritics stripped, "bin", "binti", "a/l" and the like
  /// removed, so that "Ali bin Ahmad" and "ali ahmad" are the same search.
  nameNormalised String @default("") @map("name_normalised") @db.VarChar(200)

  idType         IdType  @map("id_type")
  /// Stored as given; masked on read unless the caller holds
  /// `patient.unmask_id` and asks, which is audited (PAT-R-05).
  idNumber       String? @map("id_number") @db.VarChar(40)
  /// So the counter can search on the last four without unmasking anything.
  idNumberLast4  String? @map("id_number_last4") @db.VarChar(4)
  passportCountry String? @map("passport_country") @db.Char(2)
  passportExpiry DateTime? @map("passport_expiry") @db.Date

  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  dobEstimated Boolean   @default(false) @map("dob_estimated")
  gender       Gender
  nationality  String    @default("MY") @db.Char(2)

  race              String?        @db.VarChar(60)
  religion          String?        @db.VarChar(60)
  maritalStatus     MaritalStatus? @map("marital_status")
  occupation        String?        @db.VarChar(120)
  preferredLanguage String?        @map("preferred_language") @db.VarChar(8)

  phone    String? @db.VarChar(24)
  phoneAlt String? @map("phone_alt") @db.VarChar(24)
  email    String? @db.VarChar(254)

  addressLine1 String? @map("address_line1") @db.VarChar(200)
  addressLine2 String? @map("address_line2") @db.VarChar(200)
  postcode     String? @db.VarChar(20)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  country      String? @default("MY") @db.Char(2)

  bloodGroup BloodGroup? @map("blood_group")

  /// Null means nobody has asked (PAT-F-12). True is an explicit "no known
  /// drug allergies". False means there are some. The three states are
  /// different and the header says which.
  nkdaRecorded   Boolean?  @map("nkda_recorded")
  nkdaRecordedBy String?   @map("nkda_recorded_by") @db.Uuid
  nkdaRecordedAt DateTime? @map("nkda_recorded_at") @db.Timestamptz(3)

  notes    String? @db.VarChar(1000)
  photoKey String? @map("photo_key") @db.VarChar(200)

  status       PatientStatus @default(ACTIVE)
  mergedIntoId String?       @map("merged_into_id") @db.Uuid
  mergedAt     DateTime?     @map("merged_at") @db.Timestamptz(3)
  /// What the merge moved, so it can be put back within 30 days (PAT-R-06).
  mergeManifest Json?        @map("merge_manifest") @db.JsonB
  deceasedAt   DateTime?     @map("deceased_at") @db.Date

  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedReason String?   @map("deleted_reason") @db.VarChar(500)

  /// 'MANUAL', or 'IMPORT:<batch id>'.
  source String @default("MANUAL") @db.VarChar(60)

  /// Denormalised from encounter.completed, for the search result row only.
  lastVisitAt DateTime? @map("last_visit_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  mergedInto Patient? @relation("PatientMerge", fields: [mergedIntoId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  mergedFrom Patient[] @relation("PatientMerge")

  contacts   PatientContact[]
  consents   PatientConsent[]
  allergies  PatientAllergy[]
  conditions PatientCondition[]
  documents  PatientDocument[]
  recentlyOpened PatientRecent[]
  encounters Encounter[]
  triages    Triage[]
  consultations Consultation[]
  prescriptions       Prescription[]
  procedures          EncounterProcedure[]
  vaccinations        VaccinationRecord[]
  invoices            Invoice[]

  @@unique([tenantId, mrn], map: "patient_tenant_mrn_key")
  @@unique([id, tenantId], map: "patient_id_tenant_key")
  @@index([tenantId, phone], map: "patient_tenant_phone_idx")
  @@index([tenantId, idNumberLast4], map: "patient_tenant_id4_idx")
  /// Search by the whole number, which cannot use the partial unique index
  /// because that one also keys on the document type.
  @@index([tenantId, idNumber], map: "patient_tenant_id_number_idx")
  @@index([tenantId, status], map: "patient_tenant_status_idx")
  @@index([tenantId, lastVisitAt], map: "patient_tenant_last_visit_idx")
  /// The referencing side of the merge self-reference. PostgreSQL does not
  /// index it for you, and without it every patient delete scans the table.
  @@index([tenantId, mergedIntoId], map: "patient_merged_into_idx")
  @@map("patient")
}

model PatientContact {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  patientId String  @map("patient_id") @db.Uuid
  name      String  @db.VarChar(150)
  relationship String? @db.VarChar(60)
  phone     String  @db.VarChar(24)
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, patientId], map: "patient_contact_patient_idx")
  @@map("patient_contact")
}

model PatientConsent {
  id         String         @id @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  patientId  String         @map("patient_id") @db.Uuid
  channel    ConsentChannel
  purpose    ConsentPurpose
  granted    Boolean
  recordedBy String?        @map("recorded_by") @db.Uuid
  recordedAt DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(3)
  source     String?        @db.VarChar(60)

  patient Patient @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([patientId, channel, purpose], map: "patient_consent_unique")
  @@index([tenantId, patientId], map: "patient_consent_patient_idx")
  @@map("patient_consent")
}

model PatientAllergy {
  id        String      @id @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  patientId String      @map("patient_id") @db.Uuid
  type      AllergyType
  substance String      @db.VarChar(120)
  /// Filled in when the substance was picked from the catalogue. Free text is
  /// allowed and common, and RX warns that it can only be matched by hand.
  productId String?     @map("product_id") @db.Uuid
  drugClass String?     @map("drug_class") @db.VarChar(120)
  reaction  String?     @db.VarChar(300)
  severity  AllergySeverity?
  status    AllergyStatus

  recordedBy String   @map("recorded_by") @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  verifiedBy String?  @map("verified_by") @db.Uuid
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  refutedBy  String?  @map("refuted_by") @db.Uuid
  refutedAt  DateTime? @map("refuted_at") @db.Timestamptz(3)
  refutedReason String? @map("refuted_reason") @db.VarChar(500)
  notes      String?  @db.VarChar(500)

  patient Patient @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, patientId, status], map: "patient_allergy_patient_status_idx")
  @@map("patient_allergy")
}

model PatientCondition {
  id        String          @id @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  patientId String          @map("patient_id") @db.Uuid
  condition String          @db.VarChar(200)
  icd10Code String?         @map("icd10_code") @db.VarChar(10)
  onsetDate DateTime?       @map("onset_date") @db.Date
  status    ConditionStatus @default(ACTIVE)

  recordedBy String   @map("recorded_by") @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Date
  notes      String?  @db.VarChar(500)

  patient Patient @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, patientId, status], map: "patient_condition_patient_status_idx")
  @@map("patient_condition")
}

model PatientDocument {
  id        String              @id @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  patientId String              @map("patient_id") @db.Uuid
  type      PatientDocumentType
  filename  String              @db.VarChar(255)
  mime      String              @db.VarChar(100)
  sizeBytes Int                 @map("size_bytes")
  /// Where the bytes are. A path under the configured store today, an object
  /// key when there is object storage (V1). The route is the same either way.
  storageKey String             @map("storage_key") @db.VarChar(300)

  uploadedBy String   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  scannedAt  DateTime? @map("scanned_at") @db.Timestamptz(3)
  scanResult String?  @map("scan_result") @db.VarChar(60)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy  String?  @map("deleted_by") @db.Uuid

  patient Patient @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, patientId, type], map: "patient_document_patient_type_idx")
  @@map("patient_document")
}

model PatientImportBatch {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  filename String @db.VarChar(255)
  rowCount Int    @default(0) @map("row_count")
  imported Int    @default(0)
  skipped  Int    @default(0)
  merged   Int    @default(0)
  dryRun   Boolean @map("dry_run")
  /// The per-row verdicts, so the clinic can be shown exactly what happened.
  report   Json?   @db.JsonB
  runBy    String  @map("run_by") @db.Uuid
  runAt    DateTime @default(now()) @map("run_at") @db.Timestamptz(3)

  @@index([tenantId, runAt], map: "patient_import_tenant_time_idx")
  @@map("patient_import_batch")
}

/// PAT-F-19: what the search box shows before anything is typed.
///
/// Per user and per branch, because the useful list is "who was I dealing
/// with at this counter", not "who has this clinic seen". Kept out of the
/// audit trail on purpose: browsing a name is not an event worth recording
/// forever, and recording it would bury the events that are.
model PatientRecent {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  openedAt  DateTime @default(now()) @map("opened_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenantId, userId, branchId, patientId])
  @@index([tenantId, userId, branchId, openedAt], map: "patient_recent_lookup_idx")
  @@map("patient_recent")
}

/// One row per tenant, taken with FOR UPDATE when a number is issued. A
/// sequence object cannot be used: numbering is per tenant, and the row lock
/// is what makes two receptionists registering at once safe (PAT-F-03).
model MrnSequence {
  tenantId String @id @map("tenant_id") @db.Uuid
  next     Int    @default(1)

  @@map("mrn_sequence")
}

// ---------------------------------------------------------------------------
// Encounter & Queue (ENC, v0-04-encounter-queue.md)
//
// An encounter is one visit, and it is the spine every clinical record hangs
// from. The queue is the same row seen from the waiting room: its position in
// the clinic's physical flow, which is why both live here.
// ---------------------------------------------------------------------------

enum EncounterType {
  WALK_IN
  APPOINTMENT
  FOLLOW_UP
  EMERGENCY
}

/// §6. Ordered roughly as the day runs, which is also the order a board
/// groups them in.
enum EncounterStatus {
  REGISTERED
  TRIAGE_WAITING
  TRIAGE_IN_PROGRESS
  DOCTOR_WAITING
  IN_CONSULTATION
  PROCEDURE_WAITING
  PROCEDURE_DONE
  PHARMACY_WAITING
  DISPENSING
  PAYMENT_WAITING
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EncounterPriority {
  NORMAL
  URGENT
  EMERGENCY
}

enum RoomType {
  CONSULT
  TRIAGE
  PROCEDURE
  OTHER
}

model Encounter {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid

  /// `KL01-20260920-017`: readable, and unique for the day it belongs to.
  encounterNo String @map("encounter_no") @db.VarChar(40)
  /// `A-017`: what is called out and shown on the screen.
  queueNo     String @map("queue_no") @db.VarChar(20)

  type     EncounterType
  status   EncounterStatus
  priority EncounterPriority @default(NORMAL)
  priorityReason String?     @map("priority_reason") @db.VarChar(300)

  /// Null means "any available doctor", which is a real answer rather than
  /// a missing one: the next free doctor calls the patient.
  attendingDoctorId String? @map("attending_doctor_id") @db.Uuid
  roomId            String? @map("room_id") @db.Uuid

  registeredBy String   @map("registered_by") @db.Uuid
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz(3)
  /// When the current status was entered. The queue is ordered by it, so it
  /// is the one timestamp that must never drift.
  statusSince  DateTime @default(now()) @map("status_since") @db.Timestamptz(3)

  calledAt  DateTime? @map("called_at") @db.Timestamptz(3)
  callCount Int       @default(0) @map("call_count")
  skipCount Int       @default(0) @map("skip_count")

  triageAt              DateTime? @map("triage_at") @db.Timestamptz(3)
  consultationStartedAt DateTime? @map("consultation_started_at") @db.Timestamptz(3)
  consultationEndedAt   DateTime? @map("consultation_ended_at") @db.Timestamptz(3)
  dispensedAt           DateTime? @map("dispensed_at") @db.Timestamptz(3)
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(3)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(3)

  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason  String?   @map("cancel_reason") @db.VarChar(500)
  cancelledBy   String?   @map("cancelled_by") @db.Uuid

  reopenedAt   DateTime? @map("reopened_at") @db.Timestamptz(3)
  reopenedBy   String?   @map("reopened_by") @db.Uuid
  reopenReason String?   @map("reopen_reason") @db.VarChar(500)

  followUpDue  DateTime? @map("follow_up_due") @db.Date
  followUpNote String?   @map("follow_up_note") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  patient Patient @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  room    BranchRoom? @relation(fields: [roomId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  events  EncounterEvent[]
  triages Triage[]
  consultations Consultation[]
  prescriptions   Prescription[]
  procedures      EncounterProcedure[]
  dispenses       Dispense[]
  invoices        Invoice[]

  @@unique([tenantId, encounterNo], map: "encounter_tenant_no_key")
  @@unique([id, tenantId], map: "encounter_id_tenant_key")
  /// The queue boards, which are the hottest read in the clinic.
  @@index([tenantId, branchId, status, priority, statusSince], map: "encounter_queue_idx")
  @@index([tenantId, patientId, registeredAt], map: "encounter_patient_idx")
  @@index([tenantId, branchId, registeredAt], map: "encounter_branch_day_idx")
  @@index([tenantId, attendingDoctorId, status], map: "encounter_doctor_idx")
  @@map("encounter")
}

/// Append-only. Every transition leaves exactly one of these, and together
/// they are the evidence for any question about who waited how long and in
/// what order they were seen.
model EncounterEvent {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  encounterId String @map("encounter_id") @db.Uuid

  fromStatus String? @map("from_status") @db.VarChar(30)
  toStatus   String  @map("to_status") @db.VarChar(30)
  /// check_in, call, skip, transition, reassign, priority, cancel, no_show,
  /// reopen, force.
  action     String  @db.VarChar(20)

  actorId   String? @map("actor_id") @db.Uuid
  /// Snapshotted, so the timeline still reads correctly after a rename.
  actorName String  @map("actor_name") @db.VarChar(120)
  note      String? @db.VarChar(500)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  encounter Encounter @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, encounterId, occurredAt], map: "encounter_event_timeline_idx")
  @@index([tenantId, occurredAt], map: "encounter_event_time_idx")
  @@map("encounter_event")
}

model BranchRoom {
  id       String   @id @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  branchId String   @map("branch_id") @db.Uuid
  name     String   @db.VarChar(60)
  code     String   @db.VarChar(16)
  type     RoomType @default(CONSULT)
  active   Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch     Branch      @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  encounters Encounter[]

  @@unique([tenantId, branchId, code], map: "branch_room_code_key")
  @@unique([id, tenantId], map: "branch_room_id_tenant_key")
  @@index([tenantId, branchId, active], map: "branch_room_branch_idx")
  @@map("branch_room")
}

/// Per branch per day, taken with FOR UPDATE. Numbers restart each morning
/// because that is what a patient expects of a queue number, and they are
/// never reused within the day (ENC-R-05).
model QueueSequence {
  tenantId String   @map("tenant_id") @db.Uuid
  branchId String   @map("branch_id") @db.Uuid
  /// The clinic's own day, in the branch time zone, not UTC.
  day      DateTime @db.Date
  prefix   String   @db.VarChar(8)
  next     Int      @default(1)

  @@id([tenantId, branchId, day, prefix])
  @@map("queue_sequence")
}

/// What a waiting-room screen authenticates with. Hashed, because the screen
/// is in a public room and the token is in its address bar.
model DisplayToken {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  tokenHash Bytes     @map("token_hash")
  label     String    @db.VarChar(80)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tokenHash], map: "display_token_hash_key")
  @@index([tenantId, branchId], map: "display_token_branch_idx")
  @@map("display_token")
}

// ---------------------------------------------------------------------------
// Triage / Nurse Station (TRI, v0-05-triage.md)
//
// Vitals taken once, by the nurse, and in front of the doctor before the
// patient sits down. Everything numeric is stored as an integer in a fixed
// unit (TRI-R-01): grams, millimetres, deci-degrees. Floating point has no
// place in a clinical measurement that will be compared, summed or charted.
// ---------------------------------------------------------------------------

enum FlagLevel {
  NONE
  ABNORMAL
  CRITICAL
}

model Triage {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  encounterId String @map("encounter_id") @db.Uuid
  /// Denormalised from the encounter so that a trend across visits is one
  /// indexed read rather than a join through every encounter a patient has.
  patientId   String @map("patient_id") @db.Uuid
  /// The nth reading in this visit. A second set after a nebuliser is a new
  /// record, not an edit of the first (TRI-F-06).
  sequence    Int    @default(1)

  systolic  Int? @db.SmallInt
  diastolic Int? @db.SmallInt
  heartRate Int? @map("heart_rate") @db.SmallInt
  respRate  Int? @map("resp_rate") @db.SmallInt
  /// Deci-degrees Celsius: 372 is 37.2 °C.
  temperatureDc Int? @map("temperature_dc") @db.SmallInt
  spo2      Int? @db.SmallInt
  weightG   Int? @map("weight_g")
  heightMm  Int? @map("height_mm") @db.SmallInt
  /// Computed here, never accepted from a client (TRI-R-02). 245 is 24.5.
  bmiX10    Int? @map("bmi_x10") @db.SmallInt
  /// mmol/L × 10.
  glucoseX10     Int?     @map("glucose_x10") @db.SmallInt
  glucoseFasting Boolean? @map("glucose_fasting")
  painScore      Int?     @map("pain_score") @db.SmallInt

  complaint String? @db.VarChar(1000)
  notes     String? @db.VarChar(1000)

  /// What was out of range, and against which threshold, at the moment of
  /// saving. Stored rather than derived so that changing a threshold next
  /// year does not silently rewrite what a nurse saw today (TRI-R-03).
  flags        Json      @default("[]") @db.JsonB
  maxFlagLevel FlagLevel @default(NONE) @map("max_flag_level")

  recordedBy String   @map("recorded_by") @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// Set when the consultation is signed. After this the record is history
  /// and changes are amendments (TRI-R-04).
  lockedAt   DateTime? @map("locked_at") @db.Timestamptz(3)

  encounter  Encounter         @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  patient    Patient           @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  amendments TriageAmendment[]

  @@unique([encounterId, sequence], map: "triage_encounter_sequence_key")
  @@unique([id, tenantId], map: "triage_id_tenant_key")
  @@index([tenantId, patientId, recordedAt], map: "triage_patient_trend_idx")
  @@index([tenantId, encounterId], map: "triage_encounter_idx")
  @@map("triage")
}

/// A change made after the record was locked. The original values stay in
/// the triage row; this says what was altered, by whom and why.
model TriageAmendment {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  triageId  String   @map("triage_id") @db.Uuid
  amendedBy String   @map("amended_by") @db.Uuid
  amendedAt DateTime @default(now()) @map("amended_at") @db.Timestamptz(3)
  reason    String   @db.VarChar(500)
  previous  Json     @db.JsonB
  current   Json     @db.JsonB

  triage Triage @relation(fields: [triageId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, triageId, amendedAt], map: "triage_amendment_idx")
  @@map("triage_amendment")
}

// ---------------------------------------------------------------------------
// Consultation / EMR (CON, v0-06-consultation.md)
//
// What the patient said, what the doctor found, what they concluded and
// what they decided to do. A signed consultation is a legal document: it
// must be fast to write, complete enough to defend, and impossible to
// silently alter afterwards.
// ---------------------------------------------------------------------------

enum ConsultationStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum DiagnosisRank {
  PRIMARY
  SECONDARY
}

enum DiagnosisCertainty {
  PROVISIONAL
  CONFIRMED
}

/// An addendum adds; a correction supersedes. The original survives both.
enum AmendmentType {
  ADDENDUM
  CORRECTION
}

enum TemplateScope {
  TENANT
  USER
}

model Consultation {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  encounterId String @map("encounter_id") @db.Uuid
  patientId   String @map("patient_id") @db.Uuid
  branchId    String @map("branch_id") @db.Uuid
  doctorId    String @map("doctor_id") @db.Uuid
  /// A second consultation the same day, by another doctor, is sequence 2.
  sequence    Int    @default(1)

  status ConsultationStatus @default(DRAFT)

  chiefComplaint String? @map("chief_complaint") @db.VarChar(20000)
  hpi            String? @db.VarChar(20000)
  history        String? @db.VarChar(20000)
  examination    String? @db.VarChar(20000)
  planText       String? @map("plan_text") @db.VarChar(20000)

  templateId   String? @map("template_id") @db.Uuid
  /// CON-R-08: where copied-forward history came from, so a stale account
  /// of last month is never mistaken for what was said today.
  copiedFromId String? @map("copied_from_id") @db.Uuid

  followUpDue  DateTime? @map("follow_up_due") @db.Date
  followUpNote String?   @map("follow_up_note") @db.VarChar(500)

  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  lastAutosaveAt DateTime? @map("last_autosave_at") @db.Timestamptz(3)

  signedAt DateTime? @map("signed_at") @db.Timestamptz(3)
  signedBy String?   @map("signed_by") @db.Uuid
  signedIp String?   @map("signed_ip") @db.VarChar(45)

  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?   @map("cancel_reason") @db.VarChar(500)

  /// CON-R-02: sha256 over the canonical form of the clinical content at
  /// the moment of signing. A nightly job recomputes it, so a change made
  /// around the application is detected even if it defeated the trigger.
  contentHash String? @map("content_hash") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  encounter   Encounter               @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  patient     Patient                 @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  template    ClinicalTemplate?       @relation(fields: [templateId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  copiedFrom  Consultation?           @relation("CopyForward", fields: [copiedFromId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  copiedInto  Consultation[]          @relation("CopyForward")
  diagnoses   Diagnosis[]
  amendments  ConsultationAmendment[]
  attachments ConsultationAttachment[]
  prescription    Prescription?

  @@unique([encounterId, sequence], map: "consultation_encounter_sequence_key")
  @@unique([id, tenantId], map: "consultation_id_tenant_key")
  @@index([tenantId, encounterId], map: "consultation_encounter_idx")
  @@index([tenantId, patientId, signedAt], map: "consultation_patient_idx")
  /// A doctor's own unsigned drafts, which is their home screen.
  @@index([tenantId, doctorId, status], map: "consultation_doctor_status_idx")
  /// Drafts nobody has signed, for the administrator's dashboard.
  @@index([tenantId, status, startedAt], map: "consultation_stale_idx")
  @@map("consultation")
}

model Diagnosis {
  id             String             @id @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  consultationId String             @map("consultation_id") @db.Uuid
  patientId      String             @map("patient_id") @db.Uuid
  rank           DiagnosisRank
  description    String             @db.VarChar(200)
  icd10Code      String?            @map("icd10_code") @db.VarChar(10)
  icd10Label     String?            @map("icd10_label") @db.VarChar(300)
  certainty      DiagnosisCertainty @default(PROVISIONAL)
  /// Offers to add this to the patient's long-term conditions.
  isChronic      Boolean            @default(false) @map("is_chronic")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  consultation Consultation @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, consultationId], map: "diagnosis_consultation_idx")
  @@index([tenantId, icd10Code], map: "diagnosis_icd10_idx")
  @@map("diagnosis")
}

/// CON-F-15: the only way a signed record changes.
model ConsultationAmendment {
  id             String        @id @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  consultationId String        @map("consultation_id") @db.Uuid
  type           AmendmentType
  /// Which field a correction supersedes. Null for an addendum, which adds
  /// rather than replaces.
  field          String?       @db.VarChar(40)
  previous       Json?         @db.JsonB
  current        Json          @db.JsonB
  reason         String        @db.VarChar(1000)
  amendedBy      String        @map("amended_by") @db.Uuid
  amendedAt      DateTime      @default(now()) @map("amended_at") @db.Timestamptz(3)
  amendedIp      String?       @map("amended_ip") @db.VarChar(45)

  consultation Consultation @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, consultationId, amendedAt], map: "consultation_amendment_idx")
  @@map("consultation_amendment")
}

model ConsultationAttachment {
  id                String  @id @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  consultationId    String  @map("consultation_id") @db.Uuid
  patientDocumentId String  @map("patient_document_id") @db.Uuid
  caption           String? @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  consultation Consultation @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([consultationId, patientDocumentId], map: "consultation_attachment_key")
  @@index([tenantId, consultationId], map: "consultation_attachment_idx")
  @@map("consultation_attachment")
}

/// CON-F-07: a starting point for a common presentation, owned by the
/// clinic or by one doctor.
model ClinicalTemplate {
  id       String        @id @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  scope    TemplateScope
  /// The doctor who owns it, when the scope is USER.
  ownerId  String?       @map("owner_id") @db.Uuid
  name     String        @db.VarChar(120)
  keywords String[]      @db.VarChar(40)
  /// The sections it fills in, and the diagnoses it suggests.
  content  Json          @db.JsonB
  active   Boolean       @default(true)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  consultations Consultation[]

  @@unique([id, tenantId], map: "clinical_template_id_tenant_key")
  @@index([tenantId, scope, ownerId], map: "clinical_template_scope_idx")
  @@map("clinical_template")
}

/// CON-F-08: `.nad` becomes "No abnormality detected".
model QuickPhrase {
  id        String @id @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  trigger   String @db.VarChar(40)
  expansion String @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, trigger], map: "quick_phrase_user_trigger_key")
  @@index([tenantId, userId], map: "quick_phrase_user_idx")
  @@map("quick_phrase")
}

// ---------------------------------------------------------------------------
// Product catalogue (INV, the first half of v0-09-inventory.md)
//
// What the clinic sells and uses. Built ahead of the rest of inventory
// because prescribing depends on it: an allergy check that cannot say what
// class a drug belongs to has nothing to check against, and a warning that
// always says "check by hand" is one that gets ignored.
//
// Batches, the stock ledger, counts and reconciliation are the other half
// and stay in Phase 3. Nothing here assumes them.
// ---------------------------------------------------------------------------

enum ProductType {
  MEDICINE
  CONSUMABLE
  SUPPLY
  SERVICE_ITEM
}

enum PriceBasis {
  PRODUCT
  BATCH
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model ProductCategory {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name     String  @db.VarChar(80)
  sort     Int     @default(0)

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([id, tenantId], map: "product_category_id_tenant_key")
  @@unique([tenantId, parentId, name], map: "product_category_name_key")
  @@index([tenantId, parentId, sort], map: "product_category_tree_idx")
  @@map("product_category")
}

model Product {
  id         String  @id @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  sku        String  @db.VarChar(40)
  name       String  @db.VarChar(200)
  type       ProductType
  categoryId String? @map("category_id") @db.Uuid
  brand      String? @db.VarChar(120)

  /// Required for a medicine, and the reason this table exists before
  /// prescribing does: an allergy is recorded against a substance, and
  /// matching it needs the generic name rather than the brand on the box.
  genericName String? @map("generic_name") @db.VarChar(200)
  /// Penicillins, NSAIDs, opioids. What makes a class-level allergy
  /// warning possible at all.
  drugClass   String? @map("drug_class") @db.VarChar(120)

  form          String?  @db.VarChar(40)
  strengthText  String?  @map("strength_text") @db.VarChar(60)
  strengthValue Decimal? @map("strength_value") @db.Decimal(12, 4)
  strengthUnit  String?  @map("strength_unit") @db.VarChar(20)

  /// What one of these is handed over as: a tablet, a millilitre, a bottle.
  dispenseUnit    String  @map("dispense_unit") @db.VarChar(20)
  packSize        Int     @default(1) @map("pack_size")
  isPackDispensed Boolean @default(false) @map("is_pack_dispensed")
  /// Whether stock of it is tracked by batch. False for things with no lot
  /// number, which Phase 3 gives a synthetic batch so every movement still
  /// references one.
  isBatched       Boolean @default(true) @map("is_batched")
  isControlled    Boolean @default(false) @map("is_controlled")
  isColdChain     Boolean @default(false) @map("is_cold_chain")

  maxDailyDose     Decimal? @map("max_daily_dose") @db.Decimal(12, 4)
  maxDailyDoseUnit String?  @map("max_daily_dose_unit") @db.VarChar(20)

  /// What a prescription starts with, so a doctor changes a number rather
  /// than filling in five fields.
  defaultDose      Decimal? @map("default_dose") @db.Decimal(10, 3)
  defaultDoseUnit  String?  @map("default_dose_unit") @db.VarChar(20)
  defaultRoute     String?  @map("default_route") @db.VarChar(20)
  defaultFrequency String?  @map("default_frequency") @db.VarChar(20)

  /// Sen per dispensing unit. Integer money: a price that is a float is a
  /// price that is wrong by a sen somewhere.
  sellingPrice BigInt     @default(0) @map("selling_price")
  priceBasis   PriceBasis @default(PRODUCT) @map("price_basis")
  markupPct    Decimal?   @map("markup_pct") @db.Decimal(6, 2)

  barcodes String[] @db.VarChar(60)
  notes    String?  @db.VarChar(1000)
  status   ProductStatus @default(ACTIVE)

  /// Lower case, for searching by name, generic or brand at once.
  searchText String @default("") @map("search_text") @db.VarChar(600)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       ProductCategory?       @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  priceHistory   ProductPriceHistory[]
  branchSettings ProductBranchSetting[]
  prescriptionItems PrescriptionItem[]
  batches           ProductBatch[]
  vaccineFor        ProcedureCatalog[]    @relation("VaccineProduct")
  procedureUses     ProcedureConsumable[]

  @@unique([tenantId, sku], map: "product_sku_key")
  @@unique([id, tenantId], map: "product_id_tenant_key")
  @@index([tenantId, type, status], map: "product_type_idx")
  @@index([tenantId, genericName], map: "product_generic_idx")
  @@index([tenantId, drugClass], map: "product_class_idx")
  @@map("product")
}

/// Every price this product has ever had, and who set it. A clinic asked
/// why last month's invoice says something different deserves an answer.
model ProductPriceHistory {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sellingPrice  BigInt   @map("selling_price")
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)
  setBy         String?  @map("set_by") @db.Uuid
  reason        String?  @db.VarChar(300)

  product Product @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, productId, effectiveFrom], map: "product_price_history_idx")
  @@map("product_price_history")
}

/// Reorder levels differ by branch: a busy clinic keeps more on the shelf.
/// The numbers live here now; what consumes them arrives in Phase 3.
model ProductBranchSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid

  minStock     Decimal? @map("min_stock") @db.Decimal(12, 3)
  reorderLevel Decimal? @map("reorder_level") @db.Decimal(12, 3)
  reorderQty   Decimal? @map("reorder_qty") @db.Decimal(12, 3)

  product Product @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)
  branch  Branch  @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenantId, productId, branchId])
  @@index([tenantId, branchId], map: "product_branch_setting_branch_idx")
  @@map("product_branch_setting")
}

// ---------------------------------------------------------------------------
// Prescription (RX, v0-07-prescription.md)
//
// The clinical act of prescribing, kept apart from the physical act of
// dispensing. A prescription says what the doctor intends; a dispense says
// what left the shelf. They differ in quantity, in product and in time, and
// collapsing them makes stock wrong and intent unrecoverable.
//
// Two safety checks live here, allergy and duplicate. They are simple, and
// they are worth real care: a warning that fires constantly gets ignored,
// and then the one that mattered gets ignored too.
// ---------------------------------------------------------------------------

enum PrescriptionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PrescriptionItemStatus {
  DRAFT
  ACTIVE
  PARTIAL
  DISPENSED
  DECLINED
  CANCELLED
  SUPERSEDED
}

model Prescription {
  id             String @id @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid
  consultationId String @map("consultation_id") @db.Uuid
  patientId      String @map("patient_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  prescribedBy   String @map("prescribed_by") @db.Uuid

  status   PrescriptionStatus @default(DRAFT)
  /// The label is printed in the patient's language, not the clinic's.
  language String             @default("MS") @db.Char(2)

  notesToDispenser String? @map("notes_to_dispenser") @db.VarChar(1000)

  signedAt    DateTime? @map("signed_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items        PrescriptionItem[]
  encounter    Encounter    @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  consultation Consultation @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  patient      Patient      @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  dispenses    Dispense[]

  @@unique([consultationId], map: "prescription_consultation_key")
  @@unique([consultationId, tenantId], map: "prescription_consultation_tenant_key")
  @@unique([id, tenantId], map: "prescription_id_tenant_key")
  @@index([tenantId, patientId, signedAt], map: "prescription_patient_idx")
  @@index([tenantId, branchId, status], map: "prescription_pharmacy_queue_idx")
  @@map("prescription")
}

model PrescriptionItem {
  id             String @id @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  prescriptionId String @map("prescription_id") @db.Uuid

  /// RX-R-06: a change to a signed item is a new version, never an edit.
  version      Int     @default(1)
  supersedesId String? @map("supersedes_id") @db.Uuid
  isCurrent    Boolean @default(true) @map("is_current")

  /// Null for something the patient will have filled elsewhere.
  productId    String? @map("product_id") @db.Uuid
  externalName String? @map("external_name") @db.VarChar(200)

  /// RX-R-02: copied from the catalogue at the moment of prescribing, so
  /// editing a product next year does not rewrite what was prescribed
  /// today. The snapshot is the record; the product is only where it came
  /// from.
  genericName String  @map("generic_name") @db.VarChar(200)
  drugClass   String? @map("drug_class") @db.VarChar(120)
  strength    String? @db.VarChar(60)
  displayName String  @map("display_name") @db.VarChar(200)

  doseValue       Decimal  @map("dose_value") @db.Decimal(10, 3)
  doseUnit        String   @map("dose_unit") @db.VarChar(20)
  route           String   @db.VarChar(20)
  frequencyCode   String   @map("frequency_code") @db.VarChar(20)
  frequencyPerDay Decimal? @map("frequency_per_day") @db.Decimal(6, 3)
  isPrn           Boolean  @default(false) @map("is_prn")
  prnIndication   String?  @map("prn_indication") @db.VarChar(200)

  durationDays  Int?    @map("duration_days")
  untilFinished Boolean @default(false) @map("until_finished")

  quantity     Decimal @db.Decimal(10, 3)
  quantityUnit String  @map("quantity_unit") @db.VarChar(20)
  /// False once a doctor has typed over the calculated number.
  quantityAuto Boolean @default(true) @map("quantity_auto")

  instructions String? @db.VarChar(500)
  /// What goes on the bag. Generated when anything that changes it
  /// changes, and printed from here rather than recomputed at the counter.
  labelText    String  @map("label_text") @db.VarChar(600)

  isExternal   Boolean @default(false) @map("is_external")
  isControlled Boolean @default(false) @map("is_controlled")

  status PrescriptionItemStatus @default(DRAFT)

  /// RX-R-03: worked out by the server on every write and again at
  /// signing. The client never decides whether a warning exists.
  warnings Json @default("[]") @db.JsonB

  overrideReason String?   @map("override_reason") @db.VarChar(500)
  overriddenBy   String?   @map("overridden_by") @db.Uuid
  overriddenAt   DateTime? @map("overridden_at") @db.Timestamptz(3)
  /// RX-R-04: a severe exact match has to be confirmed again at signing.
  overrideConfirmedAt DateTime? @map("override_confirmed_at") @db.Timestamptz(3)

  cancelledReason String? @map("cancelled_reason") @db.VarChar(500)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  prescription Prescription      @relation(fields: [prescriptionId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)
  product      Product?          @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  supersedes   PrescriptionItem? @relation("ItemVersions", fields: [supersedesId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  supersededBy PrescriptionItem[] @relation("ItemVersions")

  @@unique([id, tenantId], map: "prescription_item_id_tenant_key")
  @@index([tenantId, prescriptionId, isCurrent], map: "prescription_item_current_idx")
  /// The duplicate check looks across visits and branches by generic name.
  @@index([tenantId, genericName, createdAt], map: "prescription_item_generic_idx")
  @@index([tenantId, productId], map: "prescription_item_product_idx")
  @@map("prescription_item")
}

/// RX-F-10: what this doctor prescribes most, for fast entry.
model RxFavourite {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  defaults   Json?    @db.JsonB
  uses       Int      @default(1)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)

  @@unique([userId, productId], map: "rx_favourite_user_product_key")
  @@index([tenantId, userId, uses], map: "rx_favourite_user_idx")
  @@map("rx_favourite")
}

// ---------------------------------------------------------------------------
// Stock (INV, the second half of v0-09-inventory.md)
//
// One invariant holds this together: a batch's quantity_on_hand equals the
// sum of its movements, always. If the system says 40 and the shelf says
// 12, the clinic stops trusting the system — and the distrust spreads to
// the parts that are correct.
//
// So there is exactly one write path, LedgerService.move(), which locks the
// batch, refuses a negative result, writes the movement and updates the
// cache in the caller's transaction. Every other module calls it; nobody
// writes these tables directly. A nightly job recomputes the sum and
// reports, never corrects.
// ---------------------------------------------------------------------------

enum BatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  BLOCKED
}

/// INV-F-10. Signed: the sign lives in the service, not in the caller.
enum StockMovementType {
  OPENING
  RECEIVE
  DISPENSE
  DISPENSE_REVERSAL
  /// A procedure using something up (PRC-R-01).
  CONSUME
  CONSUME_REVERSAL
  ADJUST_IN
  ADJUST_OUT
  DAMAGE
  EXPIRE
  RETURN_TO_SUPPLIER
  RETURN_FROM_PATIENT
  QUARANTINE_IN
  QUARANTINE_OUT
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_ADJUST
}

model ProductBatch {
  id        String @id @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// INV-F-09: 'NB' for a product nobody gives a lot number to. Every
  /// movement references a batch, so the ledger has no special cases.
  batchNo    String    @map("batch_no") @db.VarChar(60)
  /// Null only for a non-batched product. A month-precision expiry is
  /// stored as the last day of that month.
  expiryDate DateTime? @map("expiry_date") @db.Date

  /// Sen per dispensing unit, snapshotted onto every movement.
  costPrice    BigInt  @default(0) @map("cost_price")
  /// Set only when the product is priced per batch.
  sellingPrice BigInt? @map("selling_price")

  quantityOnHand      Decimal @default(0) @map("quantity_on_hand") @db.Decimal(12, 3)
  quantityQuarantined Decimal @default(0) @map("quantity_quarantined") @db.Decimal(12, 3)

  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  sourceType String?  @map("source_type") @db.VarChar(20)
  sourceId   String?  @map("source_id") @db.Uuid
  barcode    String?  @db.VarChar(60)
  status     BatchStatus @default(ACTIVE)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product         @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  branch    Branch          @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  movements StockMovement[]

  @@unique([branchId, productId, batchNo], map: "product_batch_key")
  @@unique([id, tenantId], map: "product_batch_id_tenant_key")
  /// FEFO reads this one, oldest expiry first.
  @@index([branchId, productId, expiryDate], map: "product_batch_fefo_idx")
  @@index([tenantId, branchId, status], map: "product_batch_branch_idx")
  @@index([tenantId, expiryDate], map: "product_batch_expiry_idx")
  @@map("product_batch")
}

/// INV-F-10, INV-R-06: append-only. Enforced by trigger, not by convention.
model StockMovement {
  id        String @id @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  batchId   String @map("batch_id") @db.Uuid

  type StockMovementType
  /// Signed. Negative takes stock off the shelf.
  quantity Decimal @db.Decimal(12, 3)
  /// Sen per unit at the moment it moved, so cost of goods does not change
  /// when the next delivery arrives at a different price.
  unitCost BigInt  @default(0) @map("unit_cost")
  /// INV-R-05: the batch's on-hand after this row. The ledger is
  /// self-auditing without recomputing from the beginning of time.
  balanceAfter Decimal @map("balance_after") @db.Decimal(12, 3)

  /// What caused it: 'dispense', 'encounter_procedure', 'stock_in'…
  referenceType String? @map("reference_type") @db.VarChar(40)
  referenceId   String? @map("reference_id") @db.Uuid
  /// INV-F-13: from a controlled list, plus the words the person typed.
  reasonCode    String? @map("reason_code") @db.VarChar(40)
  reasonText    String? @map("reason_text") @db.VarChar(500)

  performedBy     String?  @map("performed_by") @db.Uuid
  performedByName String?  @map("performed_by_name") @db.VarChar(120)
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  batch ProductBatch @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id, tenantId], map: "stock_movement_id_tenant_key")
  @@index([tenantId, batchId, occurredAt], map: "stock_movement_batch_idx")
  @@index([tenantId, branchId, productId, occurredAt], map: "stock_movement_product_idx")
  @@index([tenantId, type, occurredAt], map: "stock_movement_type_idx")
  @@index([referenceType, referenceId], map: "stock_movement_reference_idx")
  @@map("stock_movement")
}

/// INV-F-21. What the nightly check found, kept so a mismatch that appears
/// and disappears is still visible the next morning.
model ReconciliationRun {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  runAt          DateTime @default(now()) @map("run_at") @db.Timestamptz(3)
  batchesChecked Int      @default(0) @map("batches_checked")
  mismatches     Int      @default(0)
  details        Json     @default("[]") @db.JsonB

  @@index([tenantId, runAt], map: "reconciliation_run_idx")
  @@map("reconciliation_run")
}

// ---------------------------------------------------------------------------
// Procedures (PRC, v0-10-procedures.md)
//
// Injections, nebulisers, dressings, vaccinations. Ordered by a doctor,
// performed by a nurse, billed at a catalogue price, and — the part that
// earns the module its place — consuming their materials automatically.
// A nebuliser session uses a mask and a respule whether or not anybody
// remembers to write it down, and "nobody remembered" is the commonest
// reason a clinic's stock figures are wrong.
// ---------------------------------------------------------------------------

enum ProcedureCategory {
  INJECTION
  NEBULISER
  DRESSING
  MINOR_SURGERY
  VACCINATION
  SCREENING
  OTHER
}

enum ProcedureStatus {
  ORDERED
  PERFORMED
  CANCELLED
  VOIDED
}

enum Laterality {
  LEFT
  RIGHT
  BILATERAL
  NA
}

model ProcedureCatalog {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  code     String            @db.VarChar(40)
  name     String            @db.VarChar(160)
  category ProcedureCategory

  /// Sen. Integer money, like everywhere else.
  price BigInt @default(0)

  requiresConsent Boolean @default(false) @map("requires_consent")
  /// A nurse may not perform this one, whatever the branch setting says.
  requiresDoctor  Boolean @default(false) @map("requires_doctor")

  /// For a VACCINATION: what actually goes into the arm, so the batch and
  /// expiry reach the patient's record (PRC-F-03).
  vaccineProductId String? @map("vaccine_product_id") @db.Uuid

  defaultDurationMin Int?    @map("default_duration_min")
  protocol           String? @db.VarChar(4000)
  status             ProductStatus @default(ACTIVE)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vaccineProduct Product?                   @relation("VaccineProduct", fields: [vaccineProductId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  consumables    ProcedureConsumable[]
  priceHistory   ProcedurePriceHistory[]
  performed      EncounterProcedure[]

  @@unique([tenantId, code], map: "procedure_catalog_code_key")
  @@unique([id, tenantId], map: "procedure_catalog_id_tenant_key")
  @@index([tenantId, category, status], map: "procedure_catalog_category_idx")
  @@map("procedure_catalog")
}

/// PRC-F-02: what gets used up, and how much of it.
model ProcedureConsumable {
  id          String  @id @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  procedureId String  @map("procedure_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  quantity    Decimal @db.Decimal(10, 3)
  /// Prefilled but unticked: a second dressing is used sometimes, not always.
  optional    Boolean @default(false)

  procedure ProcedureCatalog @relation(fields: [procedureId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)
  product   Product          @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([procedureId, productId], map: "procedure_consumable_key")
  @@index([tenantId, productId], map: "procedure_consumable_product_idx")
  @@map("procedure_consumable")
}

/// PRC-F-04. Append-only: what a procedure cost in March is a fact.
model ProcedurePriceHistory {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  procedureId   String   @map("procedure_id") @db.Uuid
  price         BigInt
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)
  setBy         String?  @map("set_by") @db.Uuid
  reason        String?  @db.VarChar(500)

  procedure ProcedureCatalog @relation(fields: [procedureId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, procedureId, effectiveFrom], map: "procedure_price_history_idx")
  @@map("procedure_price_history")
}

model EncounterProcedure {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  branchId       String  @map("branch_id") @db.Uuid
  encounterId    String  @map("encounter_id") @db.Uuid
  patientId      String  @map("patient_id") @db.Uuid
  consultationId String? @map("consultation_id") @db.Uuid
  procedureId    String  @map("procedure_id") @db.Uuid

  /// PRC-R-02: taken at order time. A price rise next week does not
  /// change what this visit is charged.
  nameSnapshot  String @map("name_snapshot") @db.VarChar(160)
  priceSnapshot BigInt @map("price_snapshot")

  status ProcedureStatus @default(ORDERED)

  orderedBy String?  @map("ordered_by") @db.Uuid
  orderedAt DateTime @default(now()) @map("ordered_at") @db.Timestamptz(3)
  /// PRC-F-06: a nurse acted without a doctor's order, and the record says so.
  nurseInitiated Boolean @default(false) @map("nurse_initiated")

  performedBy String?   @map("performed_by") @db.Uuid
  performedAt DateTime? @map("performed_at") @db.Timestamptz(3)

  site       String?     @db.VarChar(120)
  laterality Laterality?

  consentGiven Boolean?  @map("consent_given")
  consentBy    String?   @map("consent_by") @db.VarChar(160)
  consentAt    DateTime? @map("consent_at") @db.Timestamptz(3)

  notes         String? @db.VarChar(2000)
  complications String? @db.VarChar(2000)

  cancelReason String?   @map("cancel_reason") @db.VarChar(500)
  voidedBy     String?   @map("voided_by") @db.Uuid
  voidedAt     DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason   String?   @map("void_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  procedure    ProcedureCatalog               @relation(fields: [procedureId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  encounter    Encounter                      @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  patient      Patient                        @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  consumables  EncounterProcedureConsumable[]
  vaccinations VaccinationRecord[]

  @@unique([id, tenantId], map: "encounter_procedure_id_tenant_key")
  @@index([tenantId, encounterId], map: "encounter_procedure_encounter_idx")
  @@index([tenantId, branchId, status], map: "encounter_procedure_queue_idx")
  @@index([tenantId, patientId, performedAt], map: "encounter_procedure_patient_idx")
  @@map("encounter_procedure")
}

/// What was actually used, and which movement took it off the shelf.
model EncounterProcedureConsumable {
  id                   String  @id @db.Uuid
  tenantId             String  @map("tenant_id") @db.Uuid
  encounterProcedureId String  @map("encounter_procedure_id") @db.Uuid
  productId            String  @map("product_id") @db.Uuid
  batchId              String  @map("batch_id") @db.Uuid
  quantity             Decimal @db.Decimal(10, 3)

  /// The link back into the ledger, both ways. A void writes the
  /// reversal and records it here, so "was this put back?" is answerable
  /// by looking rather than by searching the ledger.
  stockMovementId    String  @map("stock_movement_id") @db.Uuid
  reversalMovementId String? @map("reversal_movement_id") @db.Uuid

  encounterProcedure EncounterProcedure @relation(fields: [encounterProcedureId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, encounterProcedureId], map: "encounter_procedure_consumable_idx")
  @@index([tenantId, batchId], map: "encounter_procedure_consumable_batch_idx")
  @@map("encounter_procedure_consumable")
}

/// PRC-F-11. A projection, written at perform, because the question
/// "which batch went into this child" has to be answerable in a recall
/// without reconstructing it from a procedure's consumables.
model VaccinationRecord {
  id                   String @id @db.Uuid
  tenantId             String @map("tenant_id") @db.Uuid
  patientId            String @map("patient_id") @db.Uuid
  encounterProcedureId String @map("encounter_procedure_id") @db.Uuid

  vaccineProductId String    @map("vaccine_product_id") @db.Uuid
  vaccineName      String    @map("vaccine_name") @db.VarChar(200)
  batchNo          String    @map("batch_no") @db.VarChar(60)
  expiry           DateTime? @db.Date
  doseNumber       Int?      @map("dose_number")
  site             String?   @db.VarChar(120)
  givenBy          String    @map("given_by") @db.Uuid
  givenAt          DateTime  @map("given_at") @db.Timestamptz(3)

  patient            Patient            @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  encounterProcedure EncounterProcedure @relation(fields: [encounterProcedureId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, patientId, givenAt], map: "vaccination_record_patient_idx")
  @@map("vaccination_record")
}

// ---------------------------------------------------------------------------
// Dispensing (DSP, v0-08-dispensing.md)
//
// Where a prescription meets physical stock. Everything that makes the
// inventory trustworthy or untrustworthy happens in this module's
// transaction: the batch is chosen, the quantity leaves the ledger, the
// label is printed and the bill gets its lines — or none of it does.
//
// A prescription says what the doctor intended. A dispense says what
// actually left the shelf, and the two differ often enough that the
// invoice must be built from the second (DSP-R-06).
// ---------------------------------------------------------------------------

enum DispenseStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum DispenseOutcome {
  DISPENSED
  PARTIAL
  /// The patient will get it somewhere else. No stock moves, nothing billed.
  EXTERNAL
  DECLINED
  /// Replaced by another product; the replacement references this one.
  SUBSTITUTED_OUT
}

enum ControlledEntryType {
  RECEIVE
  DISPENSE
  ADJUST
  RETURN
  DESTROY
}

model Dispense {
  id             String @id @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid
  prescriptionId String @map("prescription_id") @db.Uuid
  patientId      String @map("patient_id") @db.Uuid

  status DispenseStatus @default(OPEN)

  openedBy String   @map("opened_by") @db.Uuid
  openedAt DateTime @default(now()) @map("opened_at") @db.Timestamptz(3)

  completedBy String?   @map("completed_by") @db.Uuid
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  counselled   Boolean? 
  counselledBy String?  @map("counselled_by") @db.Uuid

  notes String? @db.VarChar(1000)

  /// DSP-F-09: which version of each item the dispenser was looking at
  /// when the session opened. A doctor amending mid-session is the case
  /// this exists for.
  rxVersionSeen Json @default("{}") @map("rx_version_seen") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  prescription Prescription   @relation(fields: [prescriptionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  encounter    Encounter      @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  items        DispenseItem[]

  @@unique([id, tenantId], map: "dispense_id_tenant_key")
  @@index([tenantId, branchId, status], map: "dispense_queue_idx")
  @@index([tenantId, prescriptionId], map: "dispense_prescription_idx")
  @@map("dispense")
}

model DispenseItem {
  id         String @id @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  dispenseId String @map("dispense_id") @db.Uuid

  prescriptionItemId      String @map("prescription_item_id") @db.Uuid
  /// Which version was on the screen. A dispense against a superseded
  /// version is exactly what DSP-F-09 has to surface.
  prescriptionItemVersion Int    @map("prescription_item_version")

  /// What actually left the shelf, which may not be what was prescribed.
  /// Null only when nothing left it: an item the patient will have
  /// filled elsewhere names no product of ours to record.
  productId         String? @map("product_id") @db.Uuid
  isSubstitute      Boolean @default(false) @map("is_substitute")
  substituteReason  String? @map("substitute_reason") @db.VarChar(500)
  originalProductId String? @map("original_product_id") @db.Uuid

  quantity     Decimal @db.Decimal(10, 3)
  quantityUnit String  @map("quantity_unit") @db.VarChar(20)
  /// DSP-F-06: rounded up to whole packs, and said so on the bill.
  packRounded  Boolean @default(false) @map("pack_rounded")

  /// DSP-R-09: sen, snapshotted. A price change next week does not
  /// rewrite an invoice that has already been printed.
  unitPrice BigInt @map("unit_price")
  lineTotal BigInt @map("line_total")

  outcome       DispenseOutcome
  outcomeReason String?         @map("outcome_reason") @db.VarChar(500)

  /// Copied from the prescription item, because the bag in the patient's
  /// hand and the record have to say the same thing.
  labelText   String @map("label_text") @db.VarChar(600)
  labelPrints Int    @default(0) @map("label_prints")

  counselled Boolean?

  dispensedBy String   @map("dispensed_by") @db.Uuid
  dispensedAt DateTime @default(now()) @map("dispensed_at") @db.Timestamptz(3)

  /// DSP-F-16. The row is kept; the reversal is a fact about it.
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedBy     String?   @map("reversed_by") @db.Uuid
  reversalReason String?   @map("reversal_reason") @db.VarChar(500)

  /// DSP-F-17: handed back after the fact. Goes to quarantine, never
  /// back into saleable stock.
  returnedQuantity Decimal?  @map("returned_quantity") @db.Decimal(10, 3)
  returnedAt       DateTime? @map("returned_at") @db.Timestamptz(3)
  returnedBy       String?   @map("returned_by") @db.Uuid
  returnReason     String?   @map("return_reason") @db.VarChar(500)

  /// DSP-F-11: a retried request returns the original result rather than
  /// dispensing twice.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  dispense Dispense             @relation(fields: [dispenseId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)
  batches  DispenseItemBatch[]

  @@unique([tenantId, idempotencyKey], map: "dispense_item_idempotency_key")
  @@unique([id, tenantId], map: "dispense_item_id_tenant_key")
  @@index([tenantId, dispenseId], map: "dispense_item_dispense_idx")
  @@index([tenantId, prescriptionItemId], map: "dispense_item_rx_idx")
  @@index([tenantId, productId, dispensedAt], map: "dispense_item_product_idx")
  @@map("dispense_item")
}

/// One item may draw from several batches when no single one covers it.
model DispenseItemBatch {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  dispenseItemId String  @map("dispense_item_id") @db.Uuid
  batchId        String  @map("batch_id") @db.Uuid
  quantity       Decimal @db.Decimal(10, 3)

  /// DSP-R-07: false when the dispenser chose a different batch, and
  /// then the reason is required. FEFO compliance is reportable because
  /// of this column.
  wasSuggested   Boolean @default(true) @map("was_suggested")
  overrideReason String? @map("override_reason") @db.VarChar(500)

  stockMovementId    String  @map("stock_movement_id") @db.Uuid
  reversalMovementId String? @map("reversal_movement_id") @db.Uuid

  dispenseItem DispenseItem @relation(fields: [dispenseItemId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, dispenseItemId], map: "dispense_item_batch_item_idx")
  @@index([tenantId, batchId], map: "dispense_item_batch_batch_idx")
  @@map("dispense_item_batch")
}

/// DSP-F-18, F-19: append-only, with a running balance, because that is
/// what an inspector reads.
model ControlledDrugRegister {
  id        String @id @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  entryType     ControlledEntryType @map("entry_type")
  referenceType String?             @map("reference_type") @db.VarChar(40)
  referenceId   String?             @map("reference_id") @db.Uuid

  /// Snapshotted, and the identity number is stored unmasked because the
  /// register is a legal document that has to be readable years later.
  /// Reading it is audited.
  patientId   String? @map("patient_id") @db.Uuid
  patientName String? @map("patient_name") @db.VarChar(150)
  patientIc   String? @map("patient_ic") @db.VarChar(40)

  prescriberId   String? @map("prescriber_id") @db.Uuid
  prescriberName String? @map("prescriber_name") @db.VarChar(150)

  batchId String? @map("batch_id") @db.Uuid
  batchNo String? @map("batch_no") @db.VarChar(60)

  quantityIn   Decimal @default(0) @map("quantity_in") @db.Decimal(12, 3)
  quantityOut  Decimal @default(0) @map("quantity_out") @db.Decimal(12, 3)
  balanceAfter Decimal @map("balance_after") @db.Decimal(12, 3)

  performedBy     String  @map("performed_by") @db.Uuid
  performedByName String? @map("performed_by_name") @db.VarChar(150)
  witnessId       String? @map("witness_id") @db.Uuid
  witnessName     String? @map("witness_name") @db.VarChar(150)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([tenantId, branchId, productId, occurredAt], map: "controlled_register_idx")
  @@index([referenceType, referenceId], map: "controlled_register_reference_idx")
  @@map("controlled_drug_register")
}

// ---------------------------------------------------------------------------
// Billing (BIL, v0-11-billing.md)
//
// An invoice that is correct to the sen, every time, and explainable
// line by line to a patient at the counter and to an auditor a year
// later. Every amount here is an integer count of sen; nothing in this
// module does floating-point arithmetic on money.
//
// Once issued, an invoice does not change. The two things that may move
// afterwards are driven by payment — what has been paid, and the cash
// rounding — and a trigger names them explicitly so nothing else can.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOID
}

enum InvoiceKind {
  ENCOUNTER
  /// A walk-up sale at the counter with no visit behind it.
  STANDALONE
}

enum InvoiceLineType {
  CONSULTATION
  MEDICINE
  PROCEDURE
  DOCUMENT
  ITEM
  MANUAL
}

enum PayerType {
  PATIENT
  PANEL
  CORPORATE
}

enum TaxMode {
  INCLUSIVE
  EXCLUSIVE
}

enum FeeTimeBand {
  ANY
  AFTER_HOURS
  WEEKEND
  PUBLIC_HOLIDAY
}

model Invoice {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  encounterId String? @map("encounter_id") @db.Uuid
  patientId   String? @map("patient_id") @db.Uuid
  /// BIL-F-18: a walk-up with a name and no record.
  walkupName  String? @map("walkup_name") @db.VarChar(150)

  kind   InvoiceKind   @default(ENCOUNTER)
  status InvoiceStatus @default(DRAFT)

  /// Null while it is a draft. Gapless per branch per year once issued.
  invoiceNo  String? @map("invoice_no") @db.VarChar(40)
  seriesYear Int?    @map("series_year")
  seriesSeq  Int?    @map("series_seq")

  currency String  @default("MYR") @db.Char(3)
  taxMode  TaxMode @default(EXCLUSIVE) @map("tax_mode")

  /// All sen. `subtotal` is the sum of line gross before any discount.
  subtotal           BigInt @default(0)
  discountTotal      BigInt @default(0) @map("discount_total")
  taxTotal           BigInt @default(0) @map("tax_total")
  /// Set only by payment, for cash, and only by a few sen.
  roundingAdjustment BigInt @default(0) @map("rounding_adjustment")
  grandTotal         BigInt @default(0) @map("grand_total")
  amountPaid         BigInt @default(0) @map("amount_paid")
  balance            BigInt @default(0)

  invoiceDiscountPct    Decimal? @map("invoice_discount_pct") @db.Decimal(5, 2)
  invoiceDiscountReason String?  @map("invoice_discount_reason") @db.VarChar(500)
  invoiceDiscountSource String?  @map("invoice_discount_source") @db.VarChar(40)

  payerType    PayerType @default(PATIENT) @map("payer_type")
  payerId      String?   @map("payer_id") @db.Uuid
  membershipId String?   @map("membership_id") @db.Uuid

  /// BIL-F-13: who this was for, frozen at the moment it was issued.
  patientNameSnapshot     String? @map("patient_name_snapshot") @db.VarChar(150)
  patientIdMaskedSnapshot String? @map("patient_id_masked_snapshot") @db.VarChar(40)

  /// V1, e-invoicing. Present now so the column does not have to be
  /// added to a table full of immutable rows later.
  buyerTin              String?   @map("buyer_tin") @db.VarChar(40)
  einvoiceStatus        String?   @map("einvoice_status") @db.VarChar(40)
  einvoiceUuid          String?   @map("einvoice_uuid") @db.VarChar(80)
  einvoiceLongId        String?   @map("einvoice_long_id") @db.VarChar(200)
  einvoiceQr            String?   @map("einvoice_qr") @db.VarChar(500)
  einvoiceSubmittedAt   DateTime? @map("einvoice_submitted_at") @db.Timestamptz(3)

  issuedAt DateTime? @map("issued_at") @db.Timestamptz(3)
  issuedBy String?   @map("issued_by") @db.Uuid
  paidAt   DateTime? @map("paid_at") @db.Timestamptz(3)

  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy   String?   @map("voided_by") @db.Uuid
  voidReason String?   @map("void_reason") @db.VarChar(500)

  reissuedFromId String? @map("reissued_from_id") @db.Uuid
  reissuedAsId   String? @map("reissued_as_id") @db.Uuid

  notes String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines        InvoiceLine[]
  encounter    Encounter?    @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  patient      Patient?      @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  reissuedFrom Invoice?      @relation("Reissue", fields: [reissuedFromId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  reissuedAs   Invoice[]     @relation("Reissue")

  @@unique([tenantId, invoiceNo], map: "invoice_no_key")
  @@unique([branchId, seriesYear, seriesSeq], map: "invoice_series_key")
  @@unique([id, tenantId], map: "invoice_id_tenant_key")
  @@index([tenantId, branchId, status, issuedAt], map: "invoice_branch_idx")
  @@index([tenantId, patientId, issuedAt], map: "invoice_patient_idx")
  @@index([tenantId, encounterId], map: "invoice_encounter_idx")
  @@map("invoice")
}

model InvoiceLine {
  id        String @id @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  lineNo   Int             @map("line_no")
  lineType InvoiceLineType @map("line_type")

  /// What produced it: a dispense item, a procedure, a consultation.
  sourceType String? @map("source_type") @db.VarChar(40)
  sourceId   String? @map("source_id") @db.Uuid

  description  String  @db.VarChar(300)
  quantity     Decimal @db.Decimal(12, 3)
  quantityUnit String? @map("quantity_unit") @db.VarChar(20)
  unitPrice    BigInt  @map("unit_price")
  gross        BigInt

  discountPct    Decimal? @map("discount_pct") @db.Decimal(5, 2)
  /// What was taken off *this line specifically*. Kept apart from the
  /// total below because a recompute has to be able to tell the two
  /// apart: mistaking an allocated share for the line's own discount
  /// applies the invoice-level discount again on the next write.
  ownDiscountAmount BigInt @default(0) @map("own_discount_amount")
  /// The line's own discount plus its share of any invoice-level one,
  /// so the lines always add up to the invoice (BIL-R-03).
  discountAmount BigInt   @default(0) @map("discount_amount")
  discountSource String?  @map("discount_source") @db.VarChar(40)
  discountReason String?  @map("discount_reason") @db.VarChar(500)
  discountBy     String?  @map("discount_by") @db.Uuid

  taxCode   String @default("NONE") @map("tax_code") @db.VarChar(20)
  taxRateBp Int    @default(0) @map("tax_rate_bp")
  taxAmount BigInt @default(0) @map("tax_amount")

  lineTotal BigInt @map("line_total")

  /// Which fee-schedule rule produced a consultation fee.
  feeRule String? @map("fee_rule") @db.VarChar(80)
  /// BIL-R-08: an automatic line is changed by changing its source.
  isAuto  Boolean @map("is_auto")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([invoiceId, lineNo], map: "invoice_line_no_key")
  @@unique([id, tenantId], map: "invoice_line_id_tenant_key")
  @@index([tenantId, invoiceId], map: "invoice_line_invoice_idx")
  @@index([sourceType, sourceId], map: "invoice_line_source_idx")
  @@map("invoice_line")
}

/// BIL-R-06: the counter behind a gapless per-branch, per-year series.
model InvoiceSeries {
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  year     Int
  nextSeq  Int    @default(1) @map("next_seq")

  @@id([branchId, year], map: "invoice_series_pkey")
  @@index([tenantId], map: "invoice_series_tenant_idx")
  @@map("invoice_series")
}

/// BIL-F-03: what a cashier can add by hand without typing a price.
model BillableItem {
  id           String        @id @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  code         String        @db.VarChar(40)
  name         String        @db.VarChar(200)
  defaultPrice BigInt        @default(0) @map("default_price")
  taxCode      String        @default("NONE") @map("tax_code") @db.VarChar(20)
  category     String?       @db.VarChar(80)
  status       ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, code], map: "billable_item_code_key")
  @@index([tenantId, status], map: "billable_item_status_idx")
  @@map("billable_item")
}

/// BIL-F-05: what a consultation costs. Most specific match wins.
model FeeSchedule {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Null means "any". The more of these a row fills in, the more
  /// specific it is, and specificity decides which rule applies.
  branchId      String?  @map("branch_id") @db.Uuid
  encounterType String?  @map("encounter_type") @db.VarChar(40)
  doctorId      String?  @map("doctor_id") @db.Uuid
  timeBand      FeeTimeBand @default(ANY) @map("time_band")

  fee     BigInt
  taxCode String @default("NONE") @map("tax_code") @db.VarChar(20)

  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  /// A tie-break the clinic can reach for when two rules are equally
  /// specific. Higher wins.
  priority      Int       @default(0)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, branchId, encounterType], map: "fee_schedule_match_idx")
  @@map("fee_schedule")
}
